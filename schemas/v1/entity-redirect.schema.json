{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometa.ai/schemas/data-source-harness/v1/entity-redirect.schema.json",
  "title": "Entity Redirect",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "redirectId", "fromEntityId", "toEntityId", "reason", "assertedAt", "lineage"],
  "properties": {
    "schemaVersion": {"const": "data.harness/v1"},
    "kind": {"const": "EntityRedirect"},
    "redirectId": {"type": "string", "minLength": 1},
    "fromEntityId": {"type": "string", "minLength": 1},
    "toEntityId": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "assertedAt": {"type": "string", "format": "date-time"},
    "lineage": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["sourceId", "assetId"], "properties": {"sourceId": {"type": "string", "minLength": 1}, "assetId": {"type": "string", "minLength": 1}, "recordId": {"type": ["string", "null"]}}}}
  }
}
