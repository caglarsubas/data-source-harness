{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometa.ai/schemas/data-source-harness/v1/route-decision.schema.json",
  "title": "RouteDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "status", "routes", "uncoveredConcepts", "reasonCodes"],
  "properties": {
    "schemaVersion": {"const": "data.harness/v1"},
    "requestId": {"type": "string", "minLength": 1},
    "status": {"enum": ["selected", "refused", "escalation_required"]},
    "routes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceId", "assetId", "conceptIds", "mappingIds", "score", "watermark", "lineage"],
        "properties": {
          "sourceId": {"type": "string", "minLength": 1},
          "assetId": {"type": "string", "minLength": 1},
          "conceptIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "mappingIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "watermark": {"type": "string", "minLength": 1},
          "lineage": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceId", "assetId"],
              "properties": {
                "sourceId": {"type": "string", "minLength": 1},
                "assetId": {"type": "string", "minLength": 1},
                "recordId": {"type": ["string", "null"]},
                "fieldPath": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    },
    "uncoveredConcepts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reasonCodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "selected"}}}, "then": {"properties": {"routes": {"minItems": 1}, "uncoveredConcepts": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"enum": ["refused", "escalation_required"]}}}, "then": {"properties": {"reasonCodes": {"minItems": 1}}}}
  ]
}
