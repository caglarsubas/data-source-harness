{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometa.ai/schemas/data-source-harness/v1/bounded-query-plan.schema.json",
  "title": "BoundedQueryPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "assetIds", "fields", "filters", "relationships", "limit", "deadlineMs", "purpose", "estimatedRows"],
  "properties": {
    "schemaVersion": {"const": "data.harness/v1"},
    "sourceId": {"type": "string", "minLength": 1},
    "assetIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fields": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}},
    "filters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}
      }
    },
    "relationships": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "limit": {"type": "integer", "minimum": 1},
    "deadlineMs": {"type": "integer", "minimum": 1},
    "purpose": {"type": "string", "minLength": 1},
    "estimatedRows": {"type": "integer", "minimum": 0}
  }
}
