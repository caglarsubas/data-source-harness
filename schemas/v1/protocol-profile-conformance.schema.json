{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometa.ai/schemas/data-source-harness/v1/protocol-profile-conformance.schema.json",
  "title": "ProtocolProfileConformance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "specification", "protocolVersion", "checks", "upstreamSuite"],
  "properties": {
    "schemaVersion": {"const": "data.harness/v1"},
    "profileId": {"type": "string", "minLength": 1},
    "specification": {"type": "string", "format": "uri"},
    "protocolVersion": {"type": "string", "minLength": 1},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["checkId", "passed"], "properties": {"checkId": {"type": "string", "minLength": 1}, "passed": {"type": "boolean"}}}},
    "upstreamSuite": {"type": "object", "additionalProperties": false, "required": ["status", "reference"], "properties": {"status": {"enum": ["not-run", "passed", "failed"]}, "reference": {"type": ["string", "null"]}}}
  }
}
