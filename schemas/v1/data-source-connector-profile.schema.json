{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometa.ai/schemas/data-source-harness/v1/data-source-connector-profile.schema.json",
  "title": "Data Source Connector Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "connectorId", "version", "sdkApi", "runtimeMode", "dataModels", "capabilities", "authMethods", "limits", "consistency"],
  "properties": {
    "schemaVersion": {"const": "data.harness/v1"},
    "kind": {"const": "DataSourceConnectorProfile"},
    "connectorId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
    "version": {"type": "string", "minLength": 1},
    "sdkApi": {"const": "harness.connector/v1"},
    "runtimeMode": {"enum": ["process", "container", "wasm", "remote"]},
    "dataModels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["tabular", "document", "graph", "event", "binary", "vector"]}},
    "capabilities": {"type": "array", "minItems": 2, "uniqueItems": true, "allOf": [{"contains": {"const": "discover"}}, {"contains": {"const": "describe"}}], "items": {"enum": ["discover", "describe", "query", "scan", "search", "subscribe", "mutate", "transaction", "cdc", "explain", "predicate_pushdown", "projection_pushdown"]}},
    "authMethods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxParallelism", "maxResultBytes", "supportsCancellation"],
      "properties": {"maxParallelism": {"type": "integer", "minimum": 1}, "maxResultBytes": {"type": "integer", "minimum": 1}, "supportsCancellation": {"type": "boolean"}}
    },
    "consistency": {
      "type": "object", "additionalProperties": false,
      "required": ["readIsolation", "supportsTransactions", "supportsCheckpoint", "supportsCdc"],
      "properties": {"readIsolation": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "changeDelivery": {"type": ["string", "null"]}, "supportsTransactions": {"type": "boolean"}, "supportsCheckpoint": {"type": "boolean"}, "supportsCdc": {"type": "boolean"}}
    }
  }
}
