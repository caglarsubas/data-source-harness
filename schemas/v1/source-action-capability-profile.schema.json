{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometa.ai/schemas/data-source-harness/v1/source-action-capability-profile.schema.json",
  "title": "SourceActionCapabilityProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "sourceId", "connectorVersion", "operations"],
  "properties": {
    "schemaVersion": {"const": "data.harness/v1"},
    "kind": {"const": "SourceActionCapabilityProfile"},
    "sourceId": {"type": "string", "minLength": 1},
    "connectorVersion": {"type": "string", "minLength": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "risk", "approvalMode", "supportsIdempotencyKey", "supportsVersionPrecondition", "compensationOperation"],
        "properties": {
          "operation": {"type": "string", "minLength": 1},
          "risk": {"enum": ["low", "medium", "high"]},
          "approvalMode": {"enum": ["none", "human"]},
          "supportsIdempotencyKey": {"const": true},
          "supportsVersionPrecondition": {"const": true},
          "compensationOperation": {"type": ["string", "null"]}
        }
      }
    }
  }
}
