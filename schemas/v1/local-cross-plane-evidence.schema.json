{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometa.ai/schemas/data-source-harness/v1/local-cross-plane-evidence.schema.json",
  "title": "LocalCrossPlaneEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "campaignId", "generatedAt", "externalResourcesCreated", "components", "runtimeReceipt", "rerank", "checks", "passed"],
  "properties": {
    "schemaVersion": {"const": "data.harness.local-cross-plane-evidence/v1"},
    "campaignId": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "externalResourcesCreated": {"type": "array", "maxItems": 0},
    "components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "allOf": [
        {"contains": {"properties": {"component": {"const": "ADLC"}}, "required": ["component"]}},
        {"contains": {"properties": {"component": {"const": "Python-SDK"}}, "required": ["component"]}},
        {"contains": {"properties": {"component": {"const": "model-plane"}}, "required": ["component"]}}
      ],
      "items": {"$ref": "#/$defs/component"}
    },
    "runtimeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "artifactDigest", "policyDigest", "configurationDigest", "adlcPayloadDigest", "adlcProbeImageDigest"],
      "properties": {
        "receiptId": {"type": "string", "minLength": 1},
        "artifactDigest": {"$ref": "#/$defs/digest"},
        "policyDigest": {"$ref": "#/$defs/digest"},
        "configurationDigest": {"$ref": "#/$defs/digest"},
        "adlcPayloadDigest": {"$ref": "#/$defs/digest"},
        "adlcProbeImageDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "rerank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "model", "tenant", "resultOrder", "harnessRanking"],
      "properties": {
        "endpoint": {"const": "/v1/rerank"},
        "model": {"type": "string", "minLength": 1},
        "tenant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenant", "orgId"],
          "properties": {
            "tenant": {"type": "string", "minLength": 1},
            "orgId": {"type": "string", "minLength": 1}
          }
        },
        "resultOrder": {"$ref": "#/$defs/ranking"},
        "harnessRanking": {"$ref": "#/$defs/ranking"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "passed"],
        "properties": {
          "checkId": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"}
        }
      }
    },
    "passed": {"type": "boolean"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ranking": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 2}
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "repository", "revision", "surfaceDigest", "files"],
      "properties": {
        "component": {"enum": ["ADLC", "Python-SDK", "model-plane"]},
        "repository": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "surfaceDigest": {"$ref": "#/$defs/digest"},
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "not": {"pattern": "^/|(^|/)\\.\\.(/|$)"}},
              "digest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"passed": {"const": true}}},
      "then": {"properties": {"checks": {"items": {"properties": {"passed": {"const": true}}}}}}
    }
  ]
}
