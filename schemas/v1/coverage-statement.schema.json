{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometa.ai/schemas/data-source-harness/v1/coverage-statement.schema.json",
  "title": "Coverage Statement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "requestId", "generatedAt", "included", "excluded"],
  "properties": {
    "schemaVersion": {"const": "data.harness/v1"},
    "kind": {"const": "CoverageStatement"},
    "requestId": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "included": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["sourceId", "assetIds", "complete"], "properties": {"sourceId": {"type": "string", "minLength": 1}, "assetIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "complete": {"type": "boolean"}, "watermark": {"type": ["string", "null"]}}}},
    "excluded": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["sourceId", "reasonCode", "detail"], "properties": {"sourceId": {"type": "string", "minLength": 1}, "reasonCode": {"type": "string", "minLength": 1}, "detail": {"type": "string", "minLength": 1}}}}
  },
  "anyOf": [{"properties": {"included": {"minItems": 1}}}, {"properties": {"excluded": {"minItems": 1}}}]
}
