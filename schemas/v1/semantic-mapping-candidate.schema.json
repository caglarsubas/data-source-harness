{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestra.local/schemas/data-harness/v1/semantic-mapping-candidate.schema.json",
  "title": "SemanticMappingCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mappingId", "conceptId", "target", "confidence", "schemaDigest", "status", "proposedAt", "rationale", "lineage"],
  "properties": {
    "schemaVersion": {"const": "data.harness/v1"},
    "mappingId": {"type": "string", "minLength": 1},
    "conceptId": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "assetId", "fieldPath"],
      "properties": {
        "sourceId": {"type": "string", "minLength": 1},
        "assetId": {"type": "string", "minLength": 1},
        "fieldPath": {"type": "string", "minLength": 1}
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "schemaDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["proposed", "approved", "rejected", "quarantined"]},
    "proposedAt": {"type": "string", "format": "date-time"},
    "rationale": {"type": "string", "minLength": 1},
    "lineage": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceId", "assetId"],
        "properties": {
          "sourceId": {"type": "string", "minLength": 1},
          "assetId": {"type": "string", "minLength": 1},
          "recordId": {"type": ["string", "null"]},
          "fieldPath": {"type": ["string", "null"]}
        }
      }
    }
  }
}
