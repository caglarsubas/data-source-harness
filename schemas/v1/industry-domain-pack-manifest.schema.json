{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometa.ai/schemas/data-source-harness/v1/industry-domain-pack-manifest.schema.json",
  "title": "Industry Domain Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "packId", "version", "industry", "domains", "mockDatasets", "technologyExamples", "acceptanceScenarios"],
  "properties": {
    "schemaVersion": {"const": "data.harness/v1"},
    "kind": {"const": "IndustryDomainPackManifest"},
    "packId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "version": {"type": "string", "minLength": 1},
    "industry": {"type": "string", "minLength": 1},
    "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mockDatasets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "technologyExamples": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "acceptanceScenarios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
