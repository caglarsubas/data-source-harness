{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometa.ai/schemas/data-source-harness/v1/promotion-readiness.schema.json",
  "title": "PromotionReadiness",
  "description": "Data-plane readiness evidence; ADLC owns the authoritative PromotionDecision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseSet", "revision", "readyForAdlcDecision", "evidence", "compatibility"],
  "properties": {
    "schemaVersion": {"const": "data.harness/v1"},
    "releaseSet": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "readyForAdlcDecision": {"type": "boolean"},
    "evidence": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidenceId", "kind", "status", "digest"],
        "properties": {
          "evidenceId": {"type": "string", "minLength": 1},
          "kind": {"enum": ["source", "ci", "runtime", "stakeholder"]},
          "status": {"enum": ["passed", "failed", "missing"]},
          "digest": {"type": "string", "minLength": 1}
        }
      }
    },
    "compatibility": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component", "revision", "compatible", "evidenceId"],
        "properties": {
          "component": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "compatible": {"type": "boolean"},
          "evidenceId": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"readyForAdlcDecision": {"const": true}}},
      "then": {
        "properties": {
          "evidence": {"items": {"properties": {"status": {"const": "passed"}}}},
          "compatibility": {"items": {"properties": {"compatible": {"const": true}}}}
        }
      }
    }
  ]
}
