{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestra.local/schemas/data-harness/v1/northbound-tool-catalog.schema.json",
  "title": "NorthboundToolCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "catalogDigest", "tools"],
  "properties": {
    "schemaVersion": {"const": "data.harness/v1"},
    "protocolVersion": {"const": "data.harness.northbound/v1"},
    "catalogDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "sourceId", "assetId", "operation", "risk", "approvalMode", "purpose", "allowedAgents"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "sourceId": {"type": "string", "minLength": 1},
          "assetId": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "minLength": 1},
          "risk": {"enum": ["low", "medium", "high"]},
          "approvalMode": {"enum": ["none", "human"]},
          "purpose": {"type": "string", "minLength": 1},
          "allowedAgents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
