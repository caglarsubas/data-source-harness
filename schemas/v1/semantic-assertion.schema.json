{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometa.ai/schemas/data-source-harness/v1/semantic-assertion.schema.json",
  "title": "Semantic Assertion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "assertionId", "subjectId", "predicate", "objectId", "confidence", "assertedAt", "validFrom", "policyDigest", "lineage"],
  "properties": {
    "schemaVersion": {"const": "data.harness/v1"},
    "kind": {"const": "SemanticAssertion"},
    "assertionId": {"type": "string", "minLength": 1},
    "subjectId": {"type": "string", "minLength": 1},
    "predicate": {"enum": ["same_as", "not_same_as", "mentions"]},
    "objectId": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "assertedAt": {"type": "string", "format": "date-time"},
    "validFrom": {"type": "string", "format": "date-time"},
    "validTo": {"type": ["string", "null"], "format": "date-time"},
    "policyDigest": {"type": "string", "minLength": 1},
    "lineage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lineage"}}
  },
  "$defs": {
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "assetId"],
      "properties": {"sourceId": {"type": "string", "minLength": 1}, "assetId": {"type": "string", "minLength": 1}, "recordId": {"type": ["string", "null"]}, "fieldPath": {"type": ["string", "null"]}}
    }
  }
}
